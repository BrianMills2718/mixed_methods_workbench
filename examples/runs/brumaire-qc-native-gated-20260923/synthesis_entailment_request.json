          "document_id": "55014240-5eaa-4cde-86bb-08acf68de201",
          "end_char": 10285,
          "exact_text": "if they wish, they there record their opinions; after that the decision of the First Consul suffices.",
          "quote_hash": "e50a52287eacaa062643fdf06ccf2da7cf60dc66a5503228e7eaf541dd8a5f65",
          "start_char": 10184
